---
# ansible-lint configuration. Run from the repo root: `ansible-lint` (see README).
profile: production

# Lint the role and the test playbooks; the docs hold no Ansible content.
exclude_paths:
  - docs/
  - .github/

# Each skipped rule needs a comment saying why.
skip_list:
  # The benchmark's package controls (5.3.1.1 to 5.3.1.3) install the latest version of
  # a package by design, which package-latest flags.
  - package-latest
...
